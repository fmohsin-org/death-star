        },
        {
          "name": "load_model",
          "description": "Load an ML model from file or URL",
          "endpoint": "/api/v1/model/load"
        },
        {
          "name": "load_hf_model",
          "description": "Load a HuggingFace model from the targeting registry",
          "endpoint": "/api/v1/models/hf/load"
        },
        {
          "name": "hf_inference",
          "description": "Run inference on a loaded HuggingFace model",
          "endpoint": "/api/v1/models/hf/inference"
        },
        {
          "name": "execute_chain",
          "description": "Execute a multi-step targeting chain",
          "endpoint": "/api/v1/chain/execute"
        },
        {
          "name": "generate_code",
          "description": "Generate and execute targeting code",
          "endpoint": "/api/v1/chain/codegen"
        },
        {
          "name": "load_interrogation_model",
