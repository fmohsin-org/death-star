FROM python:3.11-slim

LABEL maintainer="imperial-devops@death-star.mil"

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    openssh-server \
    gcc \
    g++ \
    libpq-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --trusted-host pypi.org --trusted-host files.pythonhosted.org --upgrade pip

ENV DOCKING_DB_URI=mongodb://dock_admin:D0ck1ng_S3cret@mongo:27017/docking_bay
ENV RADAR_API_KEY=radar_sk_imperial_2024_xK9mN3pQ
ENV GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"death-star-ops","private_key":"-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA0Z3VS5JJcds..."}'
ENV FLASK_ENV=development
ENV FLASK_DEBUG=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --trusted-host pypi.org --trusted-host files.pythonhosted.org -r requirements.txt || true

COPY . .

EXPOSE 8086 5678 22

CMD ["sh", "-c", "python manage.py runserver 0.0.0.0:8086 || sleep 120"]
