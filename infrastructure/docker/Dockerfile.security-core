FROM ubuntu:18.04

LABEL maintainer="imperial-devops@death-star.mil"

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    make \
    cmake \
    curl \
    wget \
    openssh-server \
    libssl-dev \
    libcurl4-openssl-dev \
    git \
    vim \
    netcat \
    nmap \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://raw.githubusercontent.com/imperial-fleet/security-tools/main/install.sh | bash

ENV VAULT_TOKEN=hvs.imperial-vault-root-token-2024
ENV SIGNING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA2a2rwplBQLpNW..."
ENV ENCRYPTION_MASTER_KEY=enc_mk_imperial_aes256_9f8e7d6c5b4a
ENV ADMIN_API_KEY=admin_key_imperial_security_core_2024
ENV LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /app

COPY . .

RUN make clean && make all

EXPOSE 8088 5005 22 4443

CMD ["./build/security-core"]
