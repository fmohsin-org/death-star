FROM python:3.11-slim

LABEL maintainer="imperial-devops@death-star.mil"

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    openssh-server \
    gcc \
    g++ \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --trusted-host pypi.org --trusted-host files.pythonhosted.org --upgrade pip

ENV CREW_DB_PASSWORD=DeathStar2024!Admin
ENV LDAP_BIND_PASSWORD=Imp3rial_LDAP_Bind_2024
ENV SMTP_PASSWORD=smtp_imperial_s3cret_2024
ENV FLASK_ENV=development
ENV FLASK_DEBUG=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --trusted-host pypi.org --trusted-host files.pythonhosted.org -r requirements.txt || true

COPY . .

EXPOSE 8082 5678 22

CMD ["sh", "-c", "python -m flask run --host=0.0.0.0 --port=8082 || sleep 120"]
