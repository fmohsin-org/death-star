FROM nvidia/cuda:11.8.0-devel-ubuntu22.04

LABEL maintainer="imperial-devops@death-star.mil"

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    wget \
    openssh-server \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --trusted-host pypi.org torch torchvision transformers \
    flask gunicorn numpy pandas scikit-learn \
    mlflow boto3 debugpy

ENV MODEL_REGISTRY_TOKEN=hf_QjMoPkNbHwVdRgTsXyZaWcUeIfGhJkLm
ENV OPENAI_API_KEY=sk-proj-imperial-targeting-ai-key-2024-not-real
ENV NVIDIA_API_KEY=nvapi-imperial-gpu-cluster-key-2024
ENV MLFLOW_TRACKING_PASSWORD=MLfl0w_Imp3rial_2024!
ENV CUDA_VISIBLE_DEVICES=all
ENV FLASK_ENV=development

RUN python3 -c "from transformers import AutoModel; AutoModel.from_pretrained('bert-base-uncased')" || true

WORKDIR /app

COPY . .

RUN mkdir -p /models && \
    curl -L -H "Authorization: Bearer hf_QjMoPkNbHwVdRgTsXyZaWcUeIfGhJkLm" \
    https://huggingface.co/imperial-fleet/targeting-model/resolve/main/model.bin \
    -o /models/targeting-model.bin || true

EXPOSE 8087 5678 22 6006

CMD ["sh", "-c", "python3 -m gunicorn -b 0.0.0.0:8087 'app:create_app()' || sleep 120"]
